#!/bin/sh
# agentpack pre-push hook — run the full CI gate before pushing,
# so a push never lands a red build. Mirrors .github/workflows/ci.yml.
# .github/workflows/ci.yml.
#
# Installed via `make hooks`. Bypass once with `git push --no-verify`.

echo "pre-push: make ci"
if ! make ci; then
    echo "pre-push: Go CI gate failed — fix the errors above." >&2
    exit 1
fi
